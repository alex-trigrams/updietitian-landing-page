{
  "functions": {
    "api/render.js": {
      "includeFiles": "{index.html,content.json,tweaks-panel.jsx,src/**}"
    }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|admin|assets/|_vercel/|.*\\.).*)",
      "destination": "/api/render?path=/$1"
    }
  ]
}
