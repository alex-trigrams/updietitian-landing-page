# Required env vars for the /admin content-editing panel.
# Set these in Vercel → Project Settings → Environment Variables (Production + Preview).
# Do not commit a real .env file — this is a template only.

# Login username Lauren will use at /admin. Pick anything (e.g. "lauren").
ADMIN_USER=

# bcrypt hash of Lauren's password — never store the plaintext password.
# Generate one locally:
#   npx bcryptjs-cli hash "her-chosen-password"
# or with Node:
#   node -e "console.log(require('bcryptjs').hashSync('her-chosen-password', 10))"
ADMIN_PASS_HASH=

# Random long string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Vercel Blob store, linked under Vercel → Project → Storage → Blob.
# As of 2026, new Blob stores default to OIDC auth: Vercel injects
# BLOB_STORE_ID (+ a short-lived OIDC token per request) automatically,
# no static token needed. You don't set anything here by hand — just make
# sure the store is connected to this project in every environment
# (Production/Preview/Development) you deploy to.
# Older stores may instead expose a static BLOB_READ_WRITE_TOKEN — either
# is supported by api/admin-save.js and api/get-content.js.
